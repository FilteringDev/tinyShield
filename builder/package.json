{
  "name": "@filteringdev/tinyshield-builder",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "tsc --noEmit && oxlint --type-aware **/*.ts",
    "build": "tsx source/buildci.ts",
    "debug": "tsx source/debug.ts",
    "test": "echo \"Builder tests moved to @filteringdev/tinyshield-lib.\"",
    "test:utils": "echo \"Builder utility tests moved to @filteringdev/tinyshield-lib.\""
  },
  "dependencies": {
    "@filteringdev/tinyshield-lib": "workspace:*",
    "@types/node": "^26.4.0"
  },
  "ava": {
    "files": [
      "test/**/*.test.ts"
    ],
    "nodeArguments": [
      "--import=tsx"
    ],
    "workerThreads": false,
    "typescript": {
      "rewritePaths": {
        "@builder/": "./sources/"
      },
      "compile": false
    }
  },
  "devDependencies": {
    "@npmcli/package-json": "^8.0.0",
    "@types/npmcli__package-json": "^4.0.4",
    "@typescriptprime/parsing": "^2.0.2",
    "chokidar": "^5.0.0",
    "esbuild": "^0.28.2",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "piscina": "^5.3.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "zod": "^4.5.4"
  }
}
